{
  "name": "magnet",
  "version": "0.2.0",
  "description": "Magnet conversation relay workflow: move useful context between LLMs, apps, devices, and people.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "corepack pnpm build:relay && corepack pnpm build:web",
    "build:relay": "node ./build.mjs",
    "build:web": "corepack pnpm --filter @magnet/web build",
    "build:mobile": "corepack pnpm --filter @magnet/mobile export:web",
    "build:release": "corepack pnpm build && corepack pnpm build:mobile && corepack pnpm package:release",
    "package:release": "node scripts/package-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:container": "node scripts/verify-container.mjs",
    "dev:devices": "node ./scripts/devices.mjs",
    "dev:web": "pnpm --filter @magnet/web dev",
    "dev:mobile": "pnpm --filter @magnet/mobile start",
    "infra:synth": "corepack pnpm --filter @magnet/infra synth",
    "infra:verify": "corepack pnpm --filter @magnet/infra test",
    "test": "node scripts/prepare-tests.mjs && tsc -p tsconfig.test.json && node scripts/copy-test-migrations.mjs && node --test .testbuild/tests/*.test.js",
    "verify:http": "node ./scripts/verify-http.mjs",
    "verify:web": "node ./scripts/verify-web.mjs",
    "verify:journey": "node ./scripts/acceptance.mjs",
    "smoke": "node ./scripts/smoke.mjs",
    "db:backup": "node ./scripts/backup-sqlite.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && corepack pnpm --filter @magnet/web typecheck && corepack pnpm --filter @magnet/mobile typecheck && corepack pnpm --filter @magnet/infra typecheck",
    "db:migrate": "node --enable-source-maps ./dist/magnet/store/migrate.mjs",
    "seed": "node ./scripts/seed.mjs",
    "ask": "node ./scripts/ask.mjs",
    "demo": "node ./scripts/demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "pg": "^8.23.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "esbuild": "0.28.2",
      "fast-uri": "3.1.6",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "qs": "6.16.0"
    }
  }
}
